{
  "name": "artcom-ai/association-manager",
  "description": "A flexible association and member management plugin for WordPress.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "AssociationManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AssociationManager\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "phpcs",
    "cs:fix": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
